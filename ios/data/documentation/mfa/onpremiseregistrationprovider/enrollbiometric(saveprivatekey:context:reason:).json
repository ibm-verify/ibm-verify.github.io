n","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The caller supplies a "},{"type":"codeVoice","code":"savePrivateKey"},{"type":"text","text":" closure, which receives a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with "},{"type":"codeVoice","code":"SecKeyAddType.key"},{"type":"text","text":", containing:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the raw private key data (","type":"text"},{"code":"Data","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the key size in bits","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}],"type":"paragraph"}]}]},{"code":["import Core","","try await enrollBiometric(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).biometric\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    },","    context: nil,","    reason: \"Verify with device authentication\"",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When storing the key, use "},{"type":"codeVoice","co