aph"}]},{"name":"context","content":[{"type":"paragraph","inlineContent":[{"text":"An optional ","type":"text"},{"code":"LAContext","type":"codeVoice"},{"text":". If ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", a new ","type":"text"},{"code":"LAContext()","type":"codeVoice"},{"text":" is created.","type":"text"}]}]},{"name":"reason","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A localized explanation shown in the biometric prompt."}]}]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key."}]},{"type":"paragraph","inlineContent":[{"text":"The caller supplies a ","type":"text"},{"code":"savePrivateKey","type":"codeVoice"},{"text":" closure, which receives a ","type":"text"},{"code":"SecKeyAddType","type":"codeVoice"},{"text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with ","type":"text"},{"code":"SecKeyAddType.key","type":"codeVoice"},{"text":", containing:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the raw private key data ("},{"type":"codeVoice","code":"Data"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the key size in bits"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["import Core","","try await enrollBiometric(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistr