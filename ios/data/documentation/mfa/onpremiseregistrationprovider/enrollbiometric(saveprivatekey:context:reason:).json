l,","    reason: \"Verify with device authentication\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When storing the key, use ","type":"text"},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"text":" in your ","type":"text"},{"type":"codeVoice","code":"SecAccessControl"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors related to biometric evaluation, key generation, or enrollment."}]}],"name":"Throws","style":"note","type":"aside"}]}],"sections":[],"abstract":[{"type":"text","text":"Enrolls a signature‑based authentication method requiring biometric verification."}],"metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enrollBiometric"},{"kind":"text","text":"("},{"kind":"externalParam","text":"savePrivateKey"},{"kind":"text","text":": ("},{"preciseIdentifier":"s:4Core13SecKeyAddTypeO","kind":"typeIdentifier","text":"SecKeyAddType"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"context"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)LAContext","kind":"typeIdentifier","text":"LAContext"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","te