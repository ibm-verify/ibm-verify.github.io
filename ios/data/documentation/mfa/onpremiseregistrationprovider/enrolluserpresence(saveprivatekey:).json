t":[{"type":"text","text":"the algorithm used to generate the key"}]}]}]},{"type":"codeListing","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When storing the key, use "},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"SecAccessControl"},{"type":"text","text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See "},{"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"aside","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"Errors related to biometric evaluation, key generation, or enrollment."}],"type":"paragraph"}],"style":"note"}]}],"references":{"doc://com.ibm.verify.ios.sdk/documentation/Core/SecKeyAddType":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SecKeyAddType","kind":"identifier"}],"title":"SecKeyAddType","kind":"symbol","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","url":"\/documentation\/core\/seckeyaddtype","navigatorTitle":[{"text":"SecKeyAddType","