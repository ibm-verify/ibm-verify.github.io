ryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enrollBiometric"},{"kind":"text","text":"("},{"kind":"externalParam","text":"savePrivateKey"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:4Core13SecKeyAddTypeO","text":"SecKeyAddType","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":", ","kind":"text"},{"text":"context","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"LAContext","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)LAContext"},{"text":"?, ","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A closure that receives the generated private key wrapped in a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" and returns the label under which the key was stored. The closure may throw if storage fails."}],"type":"paragraph"}],"name":"savePrivateKey"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An optional ","type":"text"},{"code":"LAContext","type":"codeVoice"},{"text":". If ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", a new ","type":"text"},{"code":"LAContext()","type":"codeVoice"},{"text":" is created.","type":"text"}]}],"name":"context"},{"content":[{"type":"paragraph","inli