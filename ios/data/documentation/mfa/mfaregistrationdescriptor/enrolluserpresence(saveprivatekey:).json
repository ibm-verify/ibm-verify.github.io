{"hierarchy":{"paths":[["doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA","doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/MFARegistrationDescriptor"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Enrolls a signature‑based authentication method.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO","kind":"typeIdentifier","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["iOS"]}],"kind":"declarations"},{"parameters":[{"name":"savePrivateKey","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that receives the generated private key wrapped in a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" and returns the label under which the key was stored. The closure may throw if storage fails."}]}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The caller supplies a ","type":"text"},{"type":"codeVoice","code":"savePrivateKey"},{"text":" closure, which receives a ","type":"text"},{"type":"codeVoice","code":"SecKeyAddType"},{"text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with ","type":"text"},{"type":"codeVoice","code":"SecKeyAddType.key"},{"text":", containing:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the raw private key data (","type":"text"},{"code":"Data","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the key size in bits"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the algorithm used to generate the key","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When storing the key, use "},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"text":" in your ","type":"text"},{"type":"codeVoice","code":"SecAccessControl"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors related to biometric evaluation, key generation, or enrollment."}]}],"name":"Throws"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/mfa\/mfaregistrationdescriptor\/enrolluserpresence(saveprivatekey:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:3MFA25MFARegistrationDescriptorP18enrollUserPresence14savePrivateKeyySS4Core03SecI7AddTypeOKXE_tYaKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"SecKeyAddType","kind":"typeIdentifier","preciseIdentifier":"s:4Core13SecKeyAddTypeO"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"title":"enrollUserPresence(savePrivateKey:)","roleHeading":"Instance Method","role":"symbol","required":true,"modules":[{"name":"MFA"}],"symbolKind":"method"},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/MFARegistrationDescriptor\/enrollUserPresence(savePrivateKey:)","interfaceLanguage":"swift"},"references":{"doc://com.ibm.verify.ios.sdk/documentation/MFA/MFARegistrationDescriptor":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MFARegistrationDescriptor"}],"abstract":[{"type":"text","text":"An interface that registration providers implement to perform enrollment operations."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text