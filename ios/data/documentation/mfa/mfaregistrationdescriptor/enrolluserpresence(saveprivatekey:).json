{"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"kind":"attribute","text":"@"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"SecKeyAddType","kind":"typeIdentifier","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that receives the generated private key wrapped in a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" and returns the label under which the key was stored. The closure may throw if storage fails."}]}],"name":"savePrivateKey"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The caller supplies a ","type":"text"},{"code":"savePrivateKey","type":"codeVoice"},{"text":" closure, which receives a ","type":"text"},{"code":"SecKeyAddType","type":"codeVoice"},{"text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with ","type":"text"},{"code":"SecKeyAddType.key","type":"codeVoice"},{"text":", containing:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the raw private key data ("},{"code":"Data","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the key size in bits"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the algorithm used to generate the key","type":"text"}]}]}],"type":"unorderedList"},{"code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When storing the key, use ","type":"text"},{"code":"SecAccessControlCreateFlags.userPresence","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"SecAccessControl","type":"codeVoice"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type"