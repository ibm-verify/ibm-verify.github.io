{"sections":[],"abstract":[{"type":"text","text":"Enrolls a signature‑based authentication method."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enrollUserPresence"},{"kind":"text","text":"("},{"kind":"externalParam","text":"savePrivateKey"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"savePrivateKey","content":[{"type":"paragraph","inlineContent":[{"text":"A closure that receives the generated private key wrapped in a ","type":"text"},{"code":"SecKeyAddType","type":"codeVoice"},{"text":" and returns the label under which the key was stored. The closure may throw if storage fails.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The caller supplies a ","type":"text"},{"code":"savePrivateKey","type":"codeVoice"},{"text":" closure, which receives a ","type":"text"},{"code":"SecKeyAddType","type":"codeVoice"},{"text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with ","type":"text"},{"code":"SecKeyAddType.key","type":"codeVoice"},{"text":", containing:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the raw private key data (","type":"text"},{"type":"codeVoice","code":"Data"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the key size in bits"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"type":"codeListing"},{"inlineContent":[{"text":"When storing the key, use ","type":"text"},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"text":" in your ","type":"text"},{"type":"codeVoice","code":"SecAccessControl"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","