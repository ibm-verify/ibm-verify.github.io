{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enrollUserPresence"},{"kind":"text","text":"("},{"kind":"externalParam","text":"savePrivateKey"},{"kind":"text","text":": ("},{"identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","kind":"typeIdentifier","text":"SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]}]},{"kind":"parameters","parameters":[{"name":"savePrivateKey","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that receives the generated private key wrapped in a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" and returns the label under which the key was stored. The closure may throw if storage fails."}]}]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The caller supplies a "},{"code":"savePrivateKey","type":"codeVoice"},{"type":"text","text":" closure, which receives a "},{"code":"SecKeyAddType","type":"codeVoice"},{"type":"text","text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with "},{"code":"SecKeyAddType.key","type":"codeVoice"},{"type":"text","text":", containing:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"the raw private key data (","type":"text"},{"type":"codeVoice","code":"Data"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the key size in bits"}]}]},{"content":[{"inlineContent":[{"text":"the algorithm used to generate the key","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When storing the key, use "},{"code":"SecAccessControlCreateFlags.userPresence","type":"codeVoice"},{"type":"text","text":" in your "},{"code":"SecAccessControl","type":"codeVoice"},{"type":"text","text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See "},{"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Throws","content":[{"inlineContent":[{"type":"text","text":"Errors related to biometric evaluation, key generation, or enrollment."}],"type":"paragraph"}],"t