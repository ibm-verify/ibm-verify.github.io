{"kind":"symbol","abstract":[{"text":"Enrolls a signature‑based authentication method.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"SecKeyAddType","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"savePrivateKey","content":[{"inlineContent":[{"text":"A closure that receives the generated private key wrapped in a ","type":"text"},{"code":"SecKeyAddType","type":"codeVoice"},{"text":" and returns the label under which the key was stored. The closure may throw if storage fails.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller supplies a "},{"type":"codeVoice","code":"savePrivateKey"},{"type":"text","text":" closure, which receives a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with "},{"type":"codeVoice","code":"SecKeyAddType.key"},{"type":"text","text":", containing:"}]},{"items":[{"content":[{"inlineContent":[{"text":"the raw private key data (","type":"text"},{"code":"Data","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the key size in bits","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When storing the key, use "},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"SecAccessControl"},{"type":"text","text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags"},{"type":"text","text":"."}]},{"style":"note","name":"Throws","content":[{"type":"paragraph",