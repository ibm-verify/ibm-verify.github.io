eceives a ","type":"text"},{"code":"SecKeyAddType","type":"codeVoice"},{"text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with ","type":"text"},{"code":"SecKeyAddType.key","type":"codeVoice"},{"text":", containing:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the raw private key data ("},{"code":"Data","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the key size in bits","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"the algorithm used to generate the key","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When storing the key, use "},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"SecAccessControl"},{"type":"text","text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags","is