{"hierarchy":{"paths":[["doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA","doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/CloudRegistrationProvider"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"preciseIdentifier":"s:4Core13SecKeyAddTypeO","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","text":"SecKeyAddType","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that receives the generated private key wrapped in a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" and returns the label under which the key was stored. The closure may throw if storage fails."}]}],"name":"savePrivateKey"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key."}],"type":"paragraph"},{"inlineContent":[{"text":"The caller supplies a ","type":"text"},{"type":"codeVoice","code":"savePrivateKey"},{"text":" closure, which receives a ","type":"text"},{"type":"codeVoice","code":"SecKeyAddType"},{"text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with ","type":"text"},{"type":"codeVoice","code":"SecKeyAddType.key"},{"text":", containing:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the raw private key data (","type":"text"},{"type":"codeVoice","code":"Data"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the key size in bits"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"]},{"inlineContent":[{"text":"When storing the key, use ","type":"text"},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"text":" in your ","type":"text"},{"type":"codeVoice","code":"SecAccessControl"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors related to biometric evaluation, key generation, or enrollment."}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mfa\/cloudregistrationprovider\/enrolluserpresence(saveprivatekey:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"savePrivateKey"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:4Core13SecKeyAddTypeO","text":"SecKeyAddType"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"externalID":"s:3MFA25CloudRegistrationProviderC18enrollUserPresence14savePrivateKeyySS4Core03SecJ7AddTypeOKXE_tYaKF","role":"symbol","symbolKind":"method","title":"enrollUserPresence(savePrivateKey:)","roleHeading":"Instance Method","modules":[{"name":"MFA"}]},"kind":"symbol","identifier":{"url":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/CloudRegistrationProvider\/enrollUserPresence(savePrivateKey:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Enrolls a signature‑based authentication method."}],"sections":[],"references":{"doc://com.ibm.verify.ios.sdk/documentation/MFA/CloudRegistrationProvider":{"abstract":[{"text":"A mechanism for creating a multi-factor authenticator and associated factor enrollments for IBM Verify.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/CloudRegistrationProvider","title":"CloudRegistrationProvider","url":"\/documentation\/mfa\/clo