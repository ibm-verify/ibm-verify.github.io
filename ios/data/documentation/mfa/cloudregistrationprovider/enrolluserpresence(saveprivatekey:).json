{"abstract":[{"type":"text","text":"Enrolls a signature‑based authentication method."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enrollUserPresence"},{"kind":"text","text":"("},{"kind":"externalParam","text":"savePrivateKey"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:4Core13SecKeyAddTypeO","text":"SecKeyAddType","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]}]},{"kind":"parameters","parameters":[{"name":"savePrivateKey","content":[{"type":"paragraph","inlineContent":[{"text":"A closure that receives the generated private key wrapped in a ","type":"text"},{"code":"SecKeyAddType","type":"codeVoice"},{"text":" and returns the label under which the key was stored. The closure may throw if storage fails.","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The caller supplies a ","type":"text"},{"code":"savePrivateKey","type":"codeVoice"},{"text":" closure, which receives a ","type":"text"},{"code":"SecKeyAddType","type":"codeVoice"},{"text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with ","type":"text"},{"code":"SecKeyAddType.key","type":"codeVoice"},{"text":", containing:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"the raw private key data (","type":"text"},{"code":"Data","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the key size in bits"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the algorithm used to generate the key","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When storing the key, use "},{"code":"SecAccessControlCreateFlags.userPresence","type":"codeVoice"},{"type":"text","text":" in your "},{"code":"SecAccessControl","type":"codeVoice"},{"type":"text","text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See "},{"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags","type":"reference","isActive":true},{"type":"text","text":"."}]},{"style":"note","content":[{"type":"paragraph","inlineContent"