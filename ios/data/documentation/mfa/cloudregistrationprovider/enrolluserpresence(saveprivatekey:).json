{"hierarchy":{"paths":[["doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA","doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/CloudRegistrationProvider"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"SecKeyAddType","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","kind":"typeIdentifier","preciseIdentifier":"s:4Core13SecKeyAddTypeO"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"name":"savePrivateKey","content":[{"inlineContent":[{"text":"A closure that receives the generated private key wrapped in a ","type":"text"},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" and returns the label under which the key was stored. The closure may throw if storage fails."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The caller supplies a "},{"type":"codeVoice","code":"savePrivateKey"},{"type":"text","text":" closure, which receives a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with "},{"type":"codeVoice","code":"SecKeyAddType.key"},{"type":"text","text":", containing:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"the raw private key data ("},{"type":"codeVoice","code":"Data"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the key size in bits","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When storing the key, use ","type":"text"},{"code":"SecAccessControlCreateFlags.userPresence","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"SecAccessControl","type":"codeVoice"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"Errors related to biometric evaluation, key generation, or enrollment."}],"type":"paragraph"}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/mfa\/cloudregistrationprovider\/enrolluserpresence(saveprivatekey:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Enrolls a signature‑based authentication method."}],"identifier":{"url":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/CloudRegistrationProvider\/enrollUserPresence(savePrivateKey:)","interfaceLanguage":"swift"},"metadata":{"title":"enrollUserPresence(savePrivateKey:)","externalID":"s:3MFA25CloudRegistrationProviderC18enrollUserPresence14savePrivateKeyySS4Core03SecJ7AddTypeOKXE_tYaKF","modules":[{"name":"MFA"}],"role":"symbol","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"symbolKind":"method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.ibm.verify.ios.sdk/documentation/Core/SecKeyAddType":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SecKeyAddType","kind":"identifier"}],"title":"SecKeyAddType","kind":"symbol","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","url":"\/documentation\/core\/seckeyaddtype","navigatorTitle":[{"text":"SecKeyAddType","kind":"identifie