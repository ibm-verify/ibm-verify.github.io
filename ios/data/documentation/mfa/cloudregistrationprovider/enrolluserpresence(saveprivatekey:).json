:"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"]},{"inlineContent":[{"text":"When storing the key, use ","type":"text"},{"code":"SecAccessControlCreateFlags.userPresence","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"SecAccessControl","type":"codeVoice"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Throws","content":[{"inlineContent":[{"text":"Errors related to biometric evaluation, key generation, or enrollment.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://com.ibm.verify.ios.sdk/documentation/MFA/CloudRegistrationProvider/enrollUserPresence(savePrivateKey:)":{"abstract":[{"text":"Enrolls a signature‑based authentication method.","type":"text"}],"url":"\/documentation\/mfa\/cloudregistrationprovider\/enrolluserpresence(saveprivatekey:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrol