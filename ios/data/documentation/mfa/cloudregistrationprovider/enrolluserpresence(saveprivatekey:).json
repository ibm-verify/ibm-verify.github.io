{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA","doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/CloudRegistrationProvider"]]},"abstract":[{"type":"text","text":"Enrolls a signature‑based authentication method."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"SecKeyAddType","kind":"typeIdentifier","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"name":"savePrivateKey","content":[{"inlineContent":[{"type":"text","text":"A closure that receives the generated private key wrapped in a "},{"code":"SecKeyAddType","type":"codeVoice"},{"type":"text","text":" and returns the label under which the key was stored. The closure may throw if storage fails."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller supplies a "},{"type":"codeVoice","code":"savePrivateKey"},{"type":"text","text":" closure, which receives a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with "},{"type":"codeVoice","code":"SecKeyAddType.key"},{"type":"text","text":", containing:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"the raw private key data (","type":"text"},{"type":"codeVoice","code":"Data"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the key size in bits","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When storing the key, use ","type":"text"},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"text":" in your ","type":"text"},{"type":"codeVoice","code":"SecAccessControl"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"identifier":"https: