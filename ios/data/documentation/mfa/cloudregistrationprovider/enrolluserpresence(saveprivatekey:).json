ill be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When storing the key, use ","type":"text"},{"code":"SecAccessControlCreateFlags.userPresence","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"SecAccessControl","type":"codeVoice"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Errors related to biometric evaluation, key generation, or enrollment.","type":"text"}]}],"name":"Throws","style":"note","type":"aside"}],"kind":"content"}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Enrolls a signature‑based authentication method.","type":"text"}],"references":{"doc://com.ibm.verify.ios.sdk/documentation/MFA/CloudRegistrationProvider/enrollUserPresence(savePrivateKey:)":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Enrolls a signature‑based authentication method."}],"url":"\/documentation\/mfa\/cloudregistrationprovider\/enrolluserpresence(saveprivatekey:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"ident