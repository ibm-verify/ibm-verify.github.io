ivate key using the provided storage function, and then performs the enrollment using the resulting key name and public key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller supplies a "},{"type":"codeVoice","code":"savePrivateKey"},{"type":"text","text":" closure, which receives a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with "},{"type":"codeVoice","code":"SecKeyAddType.key"},{"type":"text","text":", containing:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the raw private key data ("},{"type":"codeVoice","code":"Data"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the key size in bits"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}]}]}]},{"type":"codeListing","syntax":"swift","code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"When storing the key, use ","type":"text"},{"type":"codeVoice","code":"SecAccessControlCreateFlags.userPresence"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"SecAccessControl"},{"type":"text","text":" configuration. This ensures the key is protected by biom