{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA","doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/CloudRegistrationProvider"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enrollUserPresence"},{"kind":"text","text":"("},{"kind":"externalParam","text":"savePrivateKey"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"SecKeyAddType","identifier":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/Core\/SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A closure that receives the generated private key wrapped in a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" and returns the label under which the key was stored. The closure may throw if storage fails."}],"type":"paragraph"}],"name":"savePrivateKey"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The function generates a new private\/public key pair, stores the private key using the provided storage function, and then performs the enrollment using the resulting key name and public key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller supplies a "},{"type":"codeVoice","code":"savePrivateKey"},{"type":"text","text":" closure, which receives a "},{"type":"codeVoice","code":"SecKeyAddType"},{"type":"text","text":" describing the private key that should be persisted. In this enrollment flow, the closure will always be invoked with "},{"type":"codeVoice","code":"SecKeyAddType.key"},{"type":"text","text":", containing:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the raw private key data ("},{"type":"codeVoice","code":"Data"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"text":"the key size in bits","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the algorithm used to generate the key"}],"type":"paragraph"}]}]},{"code":["import Core","","try await enrollUserPresence(","    savePrivateKey: { key in","        \/\/ We know only `.key` will be passed","        guard case let .key(value, size, algorithm) = key else {","            throw MFARegistrationError.invalidRegistrationData(reason: \"Expected SecKeyAddType.key but received a different case.\")","        }","","        \/\/ Generate a unique label for the key","        let keyLabel = \"\\(UUID().uuidString).userPresence\"","","        try KeychainService.default.addItem(keyLabel, value: .key(value: value, size: size, algorithm: algorithm))","        return keyLabel","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When storing the key, use "},{"code":"SecAccessControlCreateFlags.userPresence","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"SecAccessControl","type":"codeVoice"},{"text":" configuration. This ensures the key is protected by biometrics with automatic fallback to the device passcode, providing a smooth and secure user experience across Face ID, Touch ID, and PIN‑based verification.  See ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/security\/secaccesscontrolcreateflags"},{"text":".","type":"text"}]},{"type":"aside","name":"Throws","content":[{"inlineContent":[{"text":"Errors related to biometric evaluation, key generation, or enrollment.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"variants":[{"paths":["\/documentation\/mfa\/cloudregistrationprovider\/enrolluserpresence(saveprivatekey:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.ibm.verify.ios.sdk\/documentation\/MFA\/CloudRegistrationProvider\/enrollUserPresence(savePrivateKey:)"},"abstract":[{"type":"text","text":"Enrolls a signature‑based authentication method."}],"sections":[],"metadata":{"roleHeading":"Instance Method","title":"enrollUserPresence(savePrivateKey:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enrollUserPresence","kind":"identifier"},{"text":"(","kind":"text"},{"text":"savePrivateKey","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"SecKeyAddType","preciseIdentifier":"s:4Core13SecKeyAddTypeO","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"symbolKind":"method","modules":[{"name":"MFA"}],"externalID":"s:3MFA25CloudRegistrationProviderC18enrollUserPresence14savePrivateKeyySS4Core03SecJ7AddTypeOKXE_tYaKF"},"references":{"doc://com.ibm.verify.ios.sdk/documentation/Core/SecKeyAddType":{"kind":"symbol","abstract":[{"type":"text","text":"Represents the supported types of "},{"type":"codeVoice","code":"kSecClass"},{"type":"text","text":" items that can be added to the Keychain."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SecKeyAddType","kind":"identifier"}],"identifier":"doc:\/\/com.ibm.